# ─── Produktion (Render / Neon / Vercel) ──────────────────────────────
PORT=10000
NODE_ENV=production
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="<openssl rand -hex 32>"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="https://<vercel-url>.vercel.app"

